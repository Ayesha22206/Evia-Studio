@model Order
@{
    ViewData["Title"] = "Order Details #" + Model.Id;
    var payment = ViewBag.Payment as Payment;
}

<section class="section">
    <div style="margin-bottom:20px;">
        <a asp-controller="Orders" asp-action="Index" style="color:var(--accent-gold); font-weight:600;"><i class="fa-solid fa-arrow-left"></i> Back to Orders History</a>
    </div>

    <div class="panel">
        <div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:16px; margin-bottom:24px; border-bottom:1px solid var(--border-color); padding-bottom:16px;">
            <div>
                <h2>Order #EVIA-ORD-@Model.Id</h2>
                <p style="color:var(--text-muted); font-size:14px; margin-top:4px;">Placed on @Model.CreatedAt.ToString("f")</p>
            </div>
            <div>
                <span class="badge-status @(Model.Status == "Delivered" ? "badge-delivered" : Model.Status == "Shipped" ? "badge-shipped" : Model.Status == "Processing" ? "badge-processing" : Model.Status == "Cancelled" ? "badge-cancelled" : "badge-pending")" style="font-size:14px; padding:8px 16px;">
                    Current Status: @Model.Status
                </span>
            </div>
        </div>

        <!-- Interactive Delivery Timeline Tracker -->
        <div style="background:#0f141c; padding:24px; border-radius:var(--radius-md); border:1px solid var(--border-color); margin-bottom:30px;">
            <h4 style="font-size:14px; text-transform:uppercase; letter-spacing:1px; color:var(--text-muted); margin-bottom:20px; text-align:center;">
                Live Delivery Tracking Progress
            </h4>
            <div style="display:flex; justify-content:space-between; position:relative; max-width:650px; margin:0 auto;">
                <div style="text-align:center;">
                    <div style="width:40px; height:40px; background:#10b981; color:white; border-radius:50%; display:flex; align-items:center; justify-content:center; margin:0 auto 8px; font-weight:bold;">
                        <i class="fa-solid fa-check"></i>
                    </div>
                    <span style="font-size:12px; font-weight:600;">Order Placed</span>
                </div>
                <div style="text-align:center;">
                    <div style="width:40px; height:40px; background:@(Model.Status == "Processing" || Model.Status == "Shipped" || Model.Status == "Delivered" ? "#10b981" : "var(--border-color)"); color:white; border-radius:50%; display:flex; align-items:center; justify-content:center; margin:0 auto 8px; font-weight:bold;">
                        <i class="fa-solid fa-scissors"></i>
                    </div>
                    <span style="font-size:12px; font-weight:600;">Processing</span>
                </div>
                <div style="text-align:center;">
                    <div style="width:40px; height:40px; background:@(Model.Status == "Shipped" || Model.Status == "Delivered" ? "#10b981" : "var(--border-color)"); color:white; border-radius:50%; display:flex; align-items:center; justify-content:center; margin:0 auto 8px; font-weight:bold;">
                        <i class="fa-solid fa-truck"></i>
                    </div>
                    <span style="font-size:12px; font-weight:600;">Shipped</span>
                </div>
                <div style="text-align:center;">
                    <div style="width:40px; height:40px; background:@(Model.Status == "Delivered" ? "#10b981" : "var(--border-color)"); color:white; border-radius:50%; display:flex; align-items:center; justify-content:center; margin:0 auto 8px; font-weight:bold;">
                        <i class="fa-solid fa-house-chimney"></i>
                    </div>
                    <span style="font-size:12px; font-weight:600;">Delivered</span>
                </div>
            </div>
        </div>

        <div style="display:grid; grid-template-columns:1fr 1fr; gap:20px; margin-bottom:30px; font-size:14px;">
            <div style="background:#0f141c; padding:20px; border-radius:var(--radius-sm);">
                <h4 style="color:var(--accent-gold); margin-bottom:10px;"><i class="fa-solid fa-location-dot"></i> Shipping Address</h4>
                <p>@Model.ShippingAddress</p>
            </div>
            <div style="background:#0f141c; padding:20px; border-radius:var(--radius-sm);">
                <h4 style="color:var(--accent-gold); margin-bottom:10px;"><i class="fa-solid fa-credit-card"></i> Payment Information</h4>
                <p><strong>Method:</strong> @Model.PaymentMethod</p>
                <p><strong>Status:</strong> @Model.PaymentStatus</p>
                @if (payment != null)
                {
                    <p style="font-size:12px; color:var(--text-muted); margin-top:4px;">Transaction ID: @payment.TransactionId</p>
                }
            </div>
        </div>

        <!-- Items Breakdown -->
        <h3 style="font-size:20px; margin-bottom:16px;">Order Items</h3>
        <table class="cart-table" style="margin-bottom:24px;">
            <thead>
                <tr>
                    <th>Item</th>
                    <th>Type &amp; Details</th>
                    <th>Quantity</th>
                    <th>Price</th>
                    <th>Total</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Items)
                {
                    <tr>
                        <td>
                            @if (item.Product != null)
                            {
                                <span style="font-weight:600;">@item.Product.Name</span>
                            }
                            else if (item.CustomDesign != null)
                            {
                                <span style="font-weight:600;">Custom Outfit (@item.CustomDesign.Style)</span>
                            }
                        </td>
                        <td>
                            @if (item.Product != null)
                            {
                                <span class="badge-status badge-delivered">Ready-made (@item.Product.Category)</span>
                            }
                            else if (item.CustomDesign != null)
                            {
                                <div>
                                    <span class="badge-status badge-processing">Custom Design</span>
                                    <p style="font-size:12px; color:var(--text-muted); margin-top:4px;">
                                        Fabric: @item.CustomDesign.Fabric &bull; Size: @item.CustomDesign.Size &bull; Color: @item.CustomDesign.Color
                                    </p>
                                    @if (!string.IsNullOrEmpty(item.CustomDesign.CustomText))
                                    {
                                        <p style="font-size:12px; color:var(--accent-gold);">Slogan: "@item.CustomDesign.CustomText"</p>
                                    }
                                </div>
                            }
                        </td>
                        <td>@item.Quantity</td>
                        <td>Rs. @item.UnitPrice.ToString("N0")</td>
                        <td style="font-weight:700; color:var(--accent-gold);">Rs. @((item.UnitPrice * item.Quantity).ToString("N0"))</td>
                    </tr>
                }
            </tbody>
        </table>

        <div style="display:flex; justify-content:space-between; align-items:center; background:#0f141c; padding:20px; border-radius:var(--radius-md);">
            <div style="display:flex; gap:12px;">
                @if (Model.Status == "Pending" || Model.Status == "Paid")
                {
                    <form asp-controller="Orders" asp-action="Cancel" asp-route-id="@Model.Id" method="post" onsubmit="return confirm('Are you sure you want to cancel this order?');">
                        <button type="submit" class="btn btn-danger">
                            <i class="fa-solid fa-xmark"></i> Cancel Order
                        </button>
                    </form>
                }
                <button onclick="window.print()" class="btn btn-secondary">
                    <i class="fa-solid fa-print"></i> Print Invoice
                </button>
            </div>
            <div>
                <span style="font-size:16px; margin-right:12px; color:var(--text-muted);">Total Amount:</span>
                <span style="font-size:24px; font-weight:800; color:var(--accent-gold);">Rs. @Model.TotalAmount.ToString("N0")</span>
            </div>
        </div>
    </div>
</section>

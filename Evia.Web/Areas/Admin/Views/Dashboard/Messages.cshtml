@model List<ContactMessage>
@{
    ViewData["Title"] = "Contact Messages";
}

<div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:24px;">
    <h2><i class="fa-solid fa-envelope-open-text" style="color:var(--accent-gold);"></i> Customer Messages</h2>
    <span style="color:var(--text-muted); font-size:14px;">@Model.Count message(s)</span>
</div>

@if (!Model.Any())
{
    <div class="panel" style="padding:40px; text-align:center;">
        <i class="fa-solid fa-inbox" style="font-size:48px; color:var(--text-muted); margin-bottom:12px;"></i>
        <p style="color:var(--text-muted);">No contact messages received yet.</p>
    </div>
}
else
{
    <div style="display:flex; flex-direction:column; gap:16px;">
        @foreach (var m in Model)
        {
            <div class="panel" style="padding:20px;">
                <div style="display:flex; justify-content:space-between; align-items:flex-start; margin-bottom:12px;">
                    <div>
                        <div style="font-weight:700; font-size:15px;">
                            <i class="fa-solid fa-user-circle" style="color:var(--accent-gold); margin-right:6px;"></i>
                            @m.FullName
                        </div>
                        <div style="font-size:13px; color:var(--text-muted); margin-top:2px;">
                            <a href="mailto:@m.Email" style="color:var(--accent-gold);">@m.Email</a>
                        </div>
                    </div>
                    <span style="font-size:12px; color:var(--text-muted); white-space:nowrap;">
                        <i class="fa-regular fa-clock"></i> @m.SentAt.ToString("dd MMM yyyy, hh:mm tt")
                    </span>
                </div>
                <div style="font-size:14px; line-height:1.6; color:var(--text-secondary); padding:12px 16px; background:var(--surface-alt); border-radius:8px; border-left:3px solid var(--accent-gold);">
                    @m.Content
                </div>
            </div>
        }
    </div>
}

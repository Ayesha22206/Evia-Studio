@model List<Evia.Web.Controllers.CartItemDto>
@{
    ViewData["Title"] = "Shopping Cart";
    decimal subtotal = Model.Sum(i => i.Price * i.Quantity);
    decimal discountRate = ViewBag.PromoDiscount is decimal d ? d : 0m;
    decimal discount = subtotal * discountRate;
    decimal shipping = subtotal > 0 ? (subtotal > 5000 ? 0 : 250) : 0;
    decimal grandTotal = subtotal - discount + shipping;
}

<section class="section">
    <h2 style="margin-bottom:24px;"><i class="fa-solid fa-bag-shopping" style="color:var(--accent-gold);"></i> Shopping Basket</h2>

    @if (Model.Count == 0)
    {
        <div class="panel" style="text-align:center; padding:60px 20px;">
            <i class="fa-solid fa-cart-flatbed" style="font-size:48px; color:var(--text-muted); margin-bottom:16px;"></i>
            <h3>Your Cart is Currently Empty</h3>
            <p style="color:var(--text-muted); margin:12px 0 24px;">Explore ready-made clothing items or customize your unique outfit in our Design Studio.</p>
            <div style="display:flex; justify-content:center; gap:16px;">
                <a asp-controller="Shop" asp-action="Index" class="btn btn-secondary">Browse Shop</a>
                <a asp-controller="Design" asp-action="Index" class="btn"><i class="fa-solid fa-wand-magic-sparkles"></i> Design Your Own</a>
            </div>
        </div>
    }
    else
    {
        <div style="display:grid; grid-template-columns:1fr 340px; gap:30px;">
            <div class="panel" style="padding:0; overflow:hidden;">
                <table class="cart-table">
                    <thead>
                        <tr>
                            <th>Item Details</th>
                            <th>Type</th>
                            <th>Quantity</th>
                            <th>Unit Price</th>
                            <th>Subtotal</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td style="display:flex; align-items:center; gap:12px;">
                                    @if (!string.IsNullOrEmpty(item.ImageUrl))
                                    {
                                        <img src="@item.ImageUrl" alt="@item.Name" style="width:48px; height:48px; border-radius:6px; object-fit:cover;" onerror="this.src='/images/product-placeholder.jpg'" />
                                    }
                                    <span style="font-weight:600;">@item.Name</span>
                                </td>
                                <td>
                                    <span class="badge-status @(item.Type == "CustomDesign" ? "badge-processing" : "badge-delivered")">@item.Type</span>
                                </td>
                                <td>
                                    <form asp-controller="Cart" asp-action="UpdateQuantity" method="post" style="display:flex; align-items:center; gap:6px;">
                                        <input type="hidden" name="type" value="@item.Type" />
                                        <input type="hidden" name="id" value="@item.Id" />
                                        <input type="number" name="quantity" value="@item.Quantity" min="1" max="99" class="form-control" style="width:70px; padding:6px 10px; text-align:center;" onchange="this.form.submit()" />
                                    </form>
                                </td>
                                <td>Rs. @item.Price.ToString("N0")</td>
                                <td style="font-weight:700; color:var(--accent-gold);">Rs. @((item.Price * item.Quantity).ToString("N0"))</td>
                                <td>
                                    <form asp-controller="Cart" asp-action="Remove" method="post">
                                        <input type="hidden" name="type" value="@item.Type" />
                                        <input type="hidden" name="id" value="@item.Id" />
                                        <button type="submit" class="btn btn-danger" style="padding:8px 12px; font-size:12px; min-height:34px;" title="Remove Item">
                                            <i class="fa-solid fa-trash"></i>
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div>
                <!-- Promo Code Form -->
                <div class="panel" style="margin-bottom:20px; padding:20px;">
                    <label style="font-size:13px; font-weight:600; margin-bottom:8px; display:block;">Have a Promo Code?</label>
                    <form asp-controller="Cart" asp-action="ApplyPromo" method="post" style="display:flex; gap:8px;">
                        <input type="text" name="promoCode" class="form-control" placeholder="Enter EVIA10" style="text-transform:uppercase;" />
                        <button type="submit" class="btn btn-secondary" style="padding:10px 16px;">Apply</button>
                    </form>
                    <small style="color:var(--text-muted); display:block; margin-top:6px;">Tip: Use <strong>EVIA10</strong> for 10% off!</small>
                </div>

                <!-- Summary Panel -->
                <div class="panel" style="padding:24px;">
                    <h3 style="font-size:20px; margin-bottom:20px; border-bottom:1px solid var(--border-color); padding-bottom:12px;">Order Summary</h3>
                    
                    <div style="display:flex; justify-content:space-between; margin-bottom:12px; color:var(--text-muted);">
                        <span>Subtotal:</span>
                        <span>Rs. @subtotal.ToString("N0")</span>
                    </div>

                    @if (discount > 0)
                    {
                        <div style="display:flex; justify-content:space-between; margin-bottom:12px; color:#10b981;">
                            <span>Promo Discount (10%):</span>
                            <span>- Rs. @discount.ToString("N0")</span>
                        </div>
                    }

                    <div style="display:flex; justify-content:space-between; margin-bottom:12px; color:var(--text-muted);">
                        <span>Estimated Shipping:</span>
                        <span>@(shipping == 0 ? "FREE" : "Rs. " + shipping.ToString("N0"))</span>
                    </div>

                    <hr style="border-color:var(--border-color); margin:16px 0;" />

                    <div style="display:flex; justify-content:space-between; margin-bottom:24px; font-size:18px; font-weight:800;">
                        <span>Grand Total:</span>
                        <span style="color:var(--accent-gold);">Rs. @grandTotal.ToString("N0")</span>
                    </div>

                    <a class="btn" asp-controller="Checkout" asp-action="Index" style="width:100%;">
                        <i class="fa-solid fa-credit-card"></i> Proceed to Checkout
                    </a>
                </div>
            </div>
        </div>
    }
</section>


@model Product
@{
    ViewData["Title"] = "Edit Product";
}

<div style="max-width:700px;">
    <h2><i class="fa-solid fa-pen-to-square" style="color:var(--accent-gold);"></i> Edit Product</h2>

    <form class="admin-form" asp-action="Edit" method="post" enctype="multipart/form-data"
          asp-route-id="@Model.Id" style="margin-top:24px;">
        <div style="display:grid; grid-template-columns:1fr 1fr; gap:16px;">
            <div class="form-group" style="grid-column:1/-1;">
                <label asp-for="Name">Product Name</label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>
            <div class="form-group" style="grid-column:1/-1;">
                <label asp-for="Description">Description</label>
                <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Category">Category</label>
                <select asp-for="Category" class="form-control">
                    <option>Men</option>
                    <option>Women</option>
                    <option>Unisex</option>
                </select>
            </div>
            <div class="form-group">
                <label asp-for="Style">Style</label>
                <select asp-for="Style" class="form-control">
                    <option>Casual</option>
                    <option>Oversized</option>
                    <option>Frock</option>
                    <option>Jacket</option>
                    <option>Hoodie</option>
                    <option>Formal</option>
                </select>
            </div>
            <div class="form-group">
                <label asp-for="Color">Color</label>
                <input asp-for="Color" class="form-control" type="text" placeholder="e.g. Black, Navy Blue" />
            </div>
            <div class="form-group">
                <label asp-for="AvailableSizes">Available Sizes</label>
                <input asp-for="AvailableSizes" class="form-control" type="text" placeholder="e.g. S,M,L,XL" />
                <small style="color:var(--text-muted);">Comma-separated values</small>
            </div>
            <div class="form-group">
                <label asp-for="Price">Price (Rs.)</label>
                <input asp-for="Price" class="form-control" type="number" step="0.01" min="0" />
                <span asp-validation-for="Price" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="StockQuantity">Stock Quantity</label>
                <input asp-for="StockQuantity" class="form-control" type="number" min="0" />
                <span asp-validation-for="StockQuantity" class="text-danger"></span>
            </div>
        </div>
        <div class="form-group" style="margin-top:16px;">
            <label>
                <input type="checkbox" asp-for="IsFeatured" style="width:auto; margin-right:8px;" />
                Show as Featured on Home page
            </label>
        </div>
        <div class="form-group">
            <label>Product Image</label>
            @if (!string.IsNullOrEmpty(Model.ImageUrl))
            {
                <div style="margin-bottom:8px;">
                    <img src="@Model.ImageUrl" alt="Current" style="width:100px; height:120px; object-fit:cover; border-radius:8px; border:1px solid var(--border);"
                         onerror="this.src='https://via.placeholder.com/100x120?text=EVIA'" />
                </div>
            }
            <input type="file" name="imageFile" accept=".jpg,.jpeg,.png,.webp" />
            <small style="color:var(--text-muted);">Leave empty to keep existing image.</small>
        </div>

        <div style="display:flex; gap:12px; margin-top:24px;">
            <button type="submit" class="btn"><i class="fa-solid fa-save"></i> Update Product</button>
            <a asp-action="Index" class="btn btn-dark">Cancel</a>
        </div>
    </form>
</div>

@model List<CustomDesign>
@{
    ViewData["Title"] = "Custom Designs";
}

<div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:24px;">
    <h2><i class="fa-solid fa-wand-magic-sparkles" style="color:var(--accent-gold);"></i> Custom Designs Submissions</h2>
    <span style="color:var(--text-muted); font-size:14px;">@Model.Count design(s)</span>
</div>

@if (!Model.Any())
{
    <div class="panel" style="padding:40px; text-align:center;">
        <i class="fa-solid fa-palette" style="font-size:48px; color:var(--text-muted); margin-bottom:16px;"></i>
        <p style="color:var(--text-muted);">No custom designs have been submitted yet.</p>
    </div>
}
else
{
    <div style="display:grid; grid-template-columns:repeat(auto-fill, minmax(320px, 1fr)); gap:20px;">
        @foreach (var d in Model)
        {
            <div class="panel" style="padding:20px;">
                <div style="display:flex; gap:16px; align-items:flex-start;">
                    <!-- SVG Garment Preview -->
                    <div style="width:80px; height:100px; background:var(--surface-alt); border-radius:8px; display:flex; align-items:center; justify-content:center; flex-shrink:0;">
                        <svg width="60" height="80" viewBox="0 0 60 80">
                            @if (d.Style == "Hoodie")
                            {
                                <path d="M10,25 L20,10 L40,10 L50,25 L50,70 L10,70Z" fill="@d.Color" stroke="#555" stroke-width="1"/>
                                <path d="M20,10 Q30,20 40,10" fill="none" stroke="#555" stroke-width="1"/>
                                <ellipse cx="30" cy="6" rx="8" ry="5" fill="@d.Color" stroke="#555" stroke-width="1"/>
                            }
                            else if (d.Style == "Frock")
                            {
                                <path d="M18,15 L22,10 L38,10 L42,15 L50,70 L10,70Z" fill="@d.Color" stroke="#555" stroke-width="1"/>
                            }
                            else
                            {
                                <path d="M10,25 L20,10 L40,10 L50,25 L45,30 L45,70 L15,70 L15,30Z" fill="@d.Color" stroke="#555" stroke-width="1"/>
                            }
                        </svg>
                    </div>
                    <div style="flex:1; min-width:0;">
                        <div style="font-weight:700; font-size:15px; margin-bottom:4px;">@d.Style</div>
                        <div style="font-size:12px; color:var(--text-muted); margin-bottom:8px;">
                            by @(d.User?.FullName ?? "Unknown") &middot; @d.CreatedAt.ToString("dd MMM yyyy")
                        </div>
                        <div style="display:flex; flex-wrap:wrap; gap:6px; font-size:12px;">
                            <span style="background:var(--surface-alt); padding:3px 8px; border-radius:6px;">
                                <span style="display:inline-block; width:10px; height:10px; border-radius:50%; background:@d.Color; vertical-align:middle;"></span>
                                @d.Color
                            </span>
                            @if (!string.IsNullOrEmpty(d.Fabric))
                            {
                                <span style="background:var(--surface-alt); padding:3px 8px; border-radius:6px;">@d.Fabric</span>
                            }
                            @if (!string.IsNullOrEmpty(d.Pattern) && d.Pattern != "none")
                            {
                                <span style="background:var(--surface-alt); padding:3px 8px; border-radius:6px;">@d.Pattern</span>
                            }
                            <span style="background:var(--surface-alt); padding:3px 8px; border-radius:6px;">Size: @d.Size</span>
                        </div>
                        @if (!string.IsNullOrEmpty(d.CustomText))
                        {
                            <div style="margin-top:8px; font-size:12px; color:var(--text-muted);">
                                Text: "<span style="color:@d.TextColor">@d.CustomText</span>"
                            </div>
                        }
                        <div style="margin-top:8px; font-size:13px; font-weight:700; color:var(--accent-gold);">
                            Rs. @d.EstimatedPrice.ToString("N0")
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}

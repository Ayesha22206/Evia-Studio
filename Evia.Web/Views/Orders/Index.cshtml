@model List<Order>
@{
    ViewData["Title"] = "My Orders & Tracking";
}

<section class="section">
    <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:30px;">
        <h2><i class="fa-solid fa-box-open" style="color:var(--accent-gold);"></i> My Order History</h2>
        <a asp-controller="Shop" asp-action="Index" class="btn btn-secondary">
            <i class="fa-solid fa-cart-plus"></i> Shop More
        </a>
    </div>

    @if (Model.Count == 0)
    {
        <div class="panel" style="text-align:center; padding:60px 20px;">
            <i class="fa-solid fa-bag-shopping" style="font-size:48px; color:var(--text-muted); margin-bottom:16px;"></i>
            <h3>No Orders Placed Yet</h3>
            <p style="color:var(--text-muted); margin:12px 0 24px;">Start shopping our ready-to-wear collection or create a custom outfit design.</p>
            <a asp-controller="Shop" asp-action="Index" class="btn">Browse Shop</a>
        </div>
    }
    else
    {
        <div style="display:flex; flex-direction:column; gap:20px;">
            @foreach (var order in Model)
            {
                var statusClass = order.Status switch {
                    "Delivered" => "badge-delivered",
                    "Shipped" => "badge-shipped",
                    "Processing" => "badge-processing",
                    "Cancelled" => "badge-cancelled",
                    _ => "badge-pending"
                };

                <div class="panel" style="padding:24px;">
                    <div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:12px; margin-bottom:16px; border-bottom:1px solid var(--border-color); padding-bottom:14px;">
                        <div>
                            <span style="font-size:18px; font-weight:800; color:white;">Order #EVIA-ORD-@order.Id</span>
                            <span style="font-size:13px; color:var(--text-muted); margin-left:12px;">Placed on @order.CreatedAt.ToString("MMM dd, yyyy HH:mm")</span>
                        </div>
                        <div>
                            <span class="badge-status @statusClass">@order.Status</span>
                        </div>
                    </div>

                    <div style="display:grid; grid-template-columns:1fr 200px 180px; gap:20px; align-items:center;">
                        <div>
                            <p style="font-size:13px; color:var(--text-muted); margin-bottom:6px;">Items Included:</p>
                            <ul style="list-style:none; display:flex; flex-direction:column; gap:4px; font-size:14px;">
                                @foreach (var item in order.Items)
                                {
                                    <li>
                                        @if (item.Product != null)
                                        {
                                            <span><i class="fa-solid fa-shirt" style="color:var(--accent-gold);"></i> @item.Product.Name (x@item.Quantity)</span>
                                        }
                                        else if (item.CustomDesign != null)
                                        {
                                            <span><i class="fa-solid fa-palette" style="color:var(--accent-gold);"></i> Custom Outfit (@item.CustomDesign.Style, @item.CustomDesign.Fabric) (x@item.Quantity)</span>
                                        }
                                    </li>
                                }
                            </ul>
                        </div>

                        <div>
                            <p style="font-size:12px; color:var(--text-muted);">Payment Method</p>
                            <p style="font-weight:600; font-size:14px;">@order.PaymentMethod</p>
                            <p style="font-size:12px; color:var(--text-muted); margin-top:4px;">Status: @order.PaymentStatus</p>
                        </div>

                        <div style="text-align:right;">
                            <p style="font-size:12px; color:var(--text-muted);">Total Amount</p>
                            <p style="font-size:20px; font-weight:800; color:var(--accent-gold); margin-bottom:10px;">Rs. @order.TotalAmount.ToString("N0")</p>
                            <a asp-controller="Orders" asp-action="Details" asp-route-id="@order.Id" class="btn btn-secondary" style="padding:8px 16px; font-size:13px;">
                                View Details &amp; Track
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</section>

@{
    ViewData["Title"] = "About EVIA";
}

<section class="section" style="max-width:900px; margin:0 auto;">
    <div class="panel" style="padding:40px;">
        <h2 style="text-align:center; margin-bottom:24px;">
            <i class="fa-solid fa-heart" style="color:var(--accent-rose);"></i> About EVIA
        </h2>

        <p style="font-size:16px; line-height:1.8; color:var(--text-secondary); margin-bottom:20px;">
            EVIA is a smart online fashion platform built to make shopping for clothes easy, enjoyable, and personal.
            We bring together trendy ready-to-wear apparel for men and women with a curated catalog, secure checkout,
            and a user-friendly experience from browsing to delivery.
        </p>

        <p style="font-size:16px; line-height:1.8; color:var(--text-secondary); margin-bottom:20px;">
            What sets EVIA apart is our <strong style="color:var(--accent-gold);">Design Your Own</strong> studio — a feature
            that puts creative control in your hands. Choose your fabric, color, pattern, and style, preview your outfit live,
            and save a design that's entirely yours before it's made.
        </p>

        <div style="background:var(--surface-alt); border-radius:12px; padding:24px; margin:30px 0; border-left:4px solid var(--accent-gold);">
            <h3 style="font-size:16px; margin-bottom:12px;"><i class="fa-solid fa-graduation-cap" style="color:var(--accent-gold);"></i> Academic Project</h3>
            <p style="font-size:14px; color:var(--text-muted); line-height:1.7; margin:0;">
                This platform was developed as a Final Year Design Project at the Faculty of Computing &amp; Information Technology,
                University of the Punjab, by <strong>Ayesha Javaid</strong>, <strong>Isha Zubair</strong>, and <strong>Kalsoom Ghaffar</strong>,
                under the supervision of <strong>Prof. Irfan Shabbir</strong>.
            </p>
        </div>

        <!-- Key Features -->
        <h3 style="margin-top:30px; margin-bottom:16px; font-size:18px;">
            <i class="fa-solid fa-sparkles" style="color:var(--accent-gold);"></i> Key Features
        </h3>
        <div style="display:grid; grid-template-columns:1fr 1fr; gap:12px;">
            <div style="display:flex; align-items:flex-start; gap:10px; padding:12px; background:var(--surface-alt); border-radius:8px;">
                <i class="fa-solid fa-palette" style="color:var(--accent-gold); margin-top:2px;"></i>
                <div>
                    <strong style="font-size:14px;">Custom Design Studio</strong>
                    <p style="font-size:12px; color:var(--text-muted); margin:4px 0 0;">Pick garments, colors, fabrics, and add custom text</p>
                </div>
            </div>
            <div style="display:flex; align-items:flex-start; gap:10px; padding:12px; background:var(--surface-alt); border-radius:8px;">
                <i class="fa-solid fa-bag-shopping" style="color:var(--accent-rose); margin-top:2px;"></i>
                <div>
                    <strong style="font-size:14px;">Ready-to-Wear Catalog</strong>
                    <p style="font-size:12px; color:var(--text-muted); margin:4px 0 0;">Browse and filter trending fashion pieces</p>
                </div>
            </div>
            <div style="display:flex; align-items:flex-start; gap:10px; padding:12px; background:var(--surface-alt); border-radius:8px;">
                <i class="fa-solid fa-truck-fast" style="color:#10b981; margin-top:2px;"></i>
                <div>
                    <strong style="font-size:14px;">Order Tracking</strong>
                    <p style="font-size:12px; color:var(--text-muted); margin:4px 0 0;">Real-time status from placed to delivered</p>
                </div>
            </div>
            <div style="display:flex; align-items:flex-start; gap:10px; padding:12px; background:var(--surface-alt); border-radius:8px;">
                <i class="fa-solid fa-shield-halved" style="color:#2563eb; margin-top:2px;"></i>
                <div>
                    <strong style="font-size:14px;">Secure Payments</strong>
                    <p style="font-size:12px; color:var(--text-muted); margin:4px 0 0;">COD, Cards, JazzCash, EasyPaisa</p>
                </div>
            </div>
        </div>
    </div>
</section>

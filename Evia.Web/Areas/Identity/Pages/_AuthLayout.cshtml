<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - EVIA</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
    <style>
        :root {
            --bg-dark: #060a10;
            --bg-card: #0f1623;
            --accent-gold: #e5b869;
            --accent-gold-glow: rgba(229,184,105,0.3);
            --accent-rose: #e11d48;
            --text-main: #f1f5f9;
            --text-muted: #64748b;
            --border-color: #1e2d40;
            --radius-md: 16px;
            --radius-lg: 24px;
            --transition: all 0.35s cubic-bezier(0.4, 0, 0.2, 1);
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Inter', system-ui, -apple-system, sans-serif;
        }

        body {
            background: var(--bg-dark);
            color: var(--text-main);
            min-height: 100vh;
            overflow-x: hidden;
            position: relative;
        }

        /* Animated background mesh */
        body::before {
            content: '';
            position: fixed;
            inset: 0;
            background:
                radial-gradient(ellipse 80% 60% at 20% 10%, rgba(229,184,105,0.06) 0%, transparent 60%),
                radial-gradient(ellipse 60% 50% at 80% 90%, rgba(99,102,241,0.05) 0%, transparent 60%),
                radial-gradient(ellipse 50% 40% at 50% 50%, rgba(15,22,35,1) 0%, transparent 100%);
            pointer-events: none;
            z-index: 0;
        }

        /* Floating orbs */
        .orb {
            position: fixed;
            border-radius: 50%;
            filter: blur(80px);
            pointer-events: none;
            z-index: 0;
            animation: floatOrb 8s ease-in-out infinite alternate;
        }
        .orb-1 {
            width: 400px;
            height: 400px;
            background: radial-gradient(circle, rgba(229,184,105,0.08) 0%, transparent 70%);
            top: -100px;
            left: -100px;
            animation-delay: 0s;
        }
        .orb-2 {
            width: 300px;
            height: 300px;
            background: radial-gradient(circle, rgba(99,102,241,0.06) 0%, transparent 70%);
            bottom: -80px;
            right: -80px;
            animation-delay: -4s;
        }
        .orb-3 {
            width: 200px;
            height: 200px;
            background: radial-gradient(circle, rgba(225,29,72,0.05) 0%, transparent 70%);
            top: 50%;
            left: 60%;
            animation-delay: -2s;
        }

        @@keyframes floatOrb {
            from { transform: translate(0, 0) scale(1); }
            to { transform: translate(30px, 20px) scale(1.1); }
        }

        /* Grid lines overlay */
        body::after {
            content: '';
            position: fixed;
            inset: 0;
            background-image:
                linear-gradient(rgba(255,255,255,0.015) 1px, transparent 1px),
                linear-gradient(90deg, rgba(255,255,255,0.015) 1px, transparent 1px);
            background-size: 60px 60px;
            pointer-events: none;
            z-index: 0;
        }

        /* AUTH PAGE LAYOUT */
        .auth-page {
            position: relative;
            z-index: 1;
            min-height: 100vh;
            display: grid;
            grid-template-columns: 1fr 1fr;
        }

        /* LEFT SIDE: Brand panel */
        .auth-brand {
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: flex-start;
            padding: 60px;
            position: relative;
            overflow: hidden;
        }

        .auth-brand::before {
            content: '';
            position: absolute;
            inset: 0;
            background: linear-gradient(135deg, rgba(229,184,105,0.04) 0%, transparent 60%);
            border-right: 1px solid var(--border-color);
        }

        .brand-logo {
            display: flex;
            align-items: center;
            gap: 12px;
            margin-bottom: 60px;
            position: relative;
            z-index: 1;
        }

        .brand-logo-icon {
            width: 52px;
            height: 52px;
            background: linear-gradient(135deg, var(--accent-gold), #f3ce85);
            border-radius: 14px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 22px;
            color: #060a10;
            box-shadow: 0 8px 24px rgba(229,184,105,0.3);
        }

        .brand-logo-text {
            font-size: 30px;
            font-weight: 900;
            letter-spacing: 3px;
            color: var(--text-main);
        }

        .brand-logo-text span {
            color: var(--accent-gold);
        }

        .brand-tagline {
            position: relative;
            z-index: 1;
        }

        .brand-tagline h1 {
            font-size: 52px;
            font-weight: 800;
            line-height: 1.15;
            margin-bottom: 24px;
            background: linear-gradient(135deg, #fff 30%, var(--accent-gold) 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

        .brand-tagline p {
            font-size: 17px;
            color: var(--text-muted);
            line-height: 1.7;
            max-width: 420px;
            margin-bottom: 48px;
        }

        .brand-features {
            display: flex;
            flex-direction: column;
            gap: 18px;
            position: relative;
            z-index: 1;
        }

        .brand-feature {
            display: flex;
            align-items: center;
            gap: 14px;
            padding: 14px 20px;
            background: rgba(255,255,255,0.03);
            border: 1px solid rgba(255,255,255,0.06);
            border-radius: 12px;
            transition: var(--transition);
            animation: fadeSlideIn 0.6s ease both;
        }

        .brand-feature:nth-child(1) { animation-delay: 0.1s; }
        .brand-feature:nth-child(2) { animation-delay: 0.2s; }
        .brand-feature:nth-child(3) { animation-delay: 0.3s; }

        @@keyframes fadeSlideIn {
            from { opacity: 0; transform: translateX(-20px); }
            to { opacity: 1; transform: translateX(0); }
        }

        .brand-feature:hover {
            background: rgba(229,184,105,0.06);
            border-color: rgba(229,184,105,0.2);
        }

        .brand-feature-icon {
            width: 40px;
            height: 40px;
            background: rgba(229,184,105,0.12);
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--accent-gold);
            font-size: 16px;
            flex-shrink: 0;
        }

        .brand-feature-text strong {
            display: block;
            font-size: 14px;
            font-weight: 600;
            color: var(--text-main);
        }

        .brand-feature-text span {
            font-size: 12px;
            color: var(--text-muted);
        }

        /* RIGHT SIDE: Auth form */
        .auth-form-panel {
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            padding: 60px 40px;
            overflow-y: auto;
        }

        .auth-card {
            width: 100%;
            max-width: 440px;
            animation: fadeSlideUp 0.5s ease both;
        }

        @@keyframes fadeSlideUp {
            from { opacity: 0; transform: translateY(24px); }
            to { opacity: 1; transform: translateY(0); }
        }

        .auth-card-header {
            margin-bottom: 36px;
        }

        .auth-card-header h2 {
            font-size: 30px;
            font-weight: 800;
            color: var(--text-main);
            margin-bottom: 8px;
        }

        .auth-card-header p {
            font-size: 15px;
            color: var(--text-muted);
        }

        /* Form inputs */
        .auth-form-group {
            margin-bottom: 20px;
        }

        .auth-form-group label {
            display: block;
            font-size: 13px;
            font-weight: 600;
            color: #94a3b8;
            margin-bottom: 8px;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .auth-input-wrapper {
            position: relative;
        }

        .auth-input-icon {
            position: absolute;
            left: 16px;
            top: 50%;
            transform: translateY(-50%);
            color: var(--text-muted);
            font-size: 15px;
            pointer-events: none;
            transition: var(--transition);
        }

        .auth-input {
            width: 100%;
            padding: 14px 16px 14px 46px;
            background: rgba(255,255,255,0.04);
            border: 1px solid var(--border-color);
            border-radius: var(--radius-md);
            color: var(--text-main);
            font-size: 15px;
            font-family: 'Inter', sans-serif;
            transition: var(--transition);
            outline: none;
        }

        .auth-input:focus {
            background: rgba(255,255,255,0.07);
            border-color: var(--accent-gold);
            box-shadow: 0 0 0 3px rgba(229,184,105,0.12), 0 4px 20px rgba(229,184,105,0.08);
        }

        .auth-input:focus ~ .auth-input-icon,
        .auth-input:focus + .auth-input-icon {
            color: var(--accent-gold);
        }

        .auth-input::placeholder {
            color: #334155;
        }

        /* Password toggle */
        .password-toggle {
            position: absolute;
            right: 16px;
            top: 50%;
            transform: translateY(-50%);
            background: none;
            border: none;
            color: var(--text-muted);
            cursor: pointer;
            padding: 4px;
            font-size: 15px;
            transition: var(--transition);
        }

        .password-toggle:hover {
            color: var(--accent-gold);
        }

        /* Validation messages */
        .auth-validation {
            font-size: 12px;
            color: var(--accent-rose);
            margin-top: 6px;
            display: flex;
            align-items: center;
            gap: 4px;
        }

        /* Submit button */
        .auth-btn {
            width: 100%;
            padding: 15px;
            background: linear-gradient(135deg, var(--accent-gold), #f3ce85);
            color: #060a10;
            font-weight: 800;
            font-size: 15px;
            font-family: 'Inter', sans-serif;
            border: none;
            border-radius: var(--radius-md);
            cursor: pointer;
            transition: var(--transition);
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            letter-spacing: 0.3px;
            margin-top: 8px;
            position: relative;
            overflow: hidden;
        }

        .auth-btn::before {
            content: '';
            position: absolute;
            inset: 0;
            background: linear-gradient(135deg, rgba(255,255,255,0.15), transparent);
            opacity: 0;
            transition: var(--transition);
        }

        .auth-btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 12px 32px rgba(229,184,105,0.35);
        }

        .auth-btn:hover::before {
            opacity: 1;
        }

        .auth-btn:active {
            transform: translateY(0);
        }

        /* Divider */
        .auth-divider {
            display: flex;
            align-items: center;
            gap: 16px;
            margin: 24px 0;
            color: var(--text-muted);
            font-size: 13px;
        }

        .auth-divider::before,
        .auth-divider::after {
            content: '';
            flex: 1;
            height: 1px;
            background: var(--border-color);
        }

        /* Links */
        .auth-switch {
            text-align: center;
            margin-top: 28px;
            font-size: 14px;
            color: var(--text-muted);
        }

        .auth-switch a {
            color: var(--accent-gold);
            font-weight: 600;
            text-decoration: none;
            transition: var(--transition);
        }

        .auth-switch a:hover {
            color: #f3ce85;
            text-decoration: underline;
        }

        /* Checkbox */
        .auth-checkbox-row {
            display: flex;
            align-items: center;
            gap: 10px;
            margin-bottom: 20px;
        }

        .auth-checkbox {
            width: 18px;
            height: 18px;
            accent-color: var(--accent-gold);
            cursor: pointer;
        }

        .auth-checkbox-label {
            font-size: 14px;
            color: var(--text-muted);
            cursor: pointer;
        }

        /* Forgot password */
        .auth-forgot {
            text-align: right;
            margin-top: -10px;
            margin-bottom: 20px;
        }

        .auth-forgot a {
            font-size: 13px;
            color: var(--text-muted);
            text-decoration: none;
            transition: var(--transition);
        }

        .auth-forgot a:hover {
            color: var(--accent-gold);
        }

        /* Error summary */
        .auth-error-summary {
            background: rgba(225,29,72,0.08);
            border: 1px solid rgba(225,29,72,0.25);
            border-radius: var(--radius-md);
            padding: 14px 18px;
            margin-bottom: 24px;
            font-size: 14px;
            color: #fb7185;
        }

        /* Responsive */
        @@media (max-width: 900px) {
            .auth-page {
                grid-template-columns: 1fr;
            }
            .auth-brand {
                display: none;
            }
            .auth-form-panel {
                padding: 40px 24px;
            }
        }

        a {
            color: inherit;
            text-decoration: none;
        }
    </style>
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <div class="orb orb-1"></div>
    <div class="orb orb-2"></div>
    <div class="orb orb-3"></div>

    <div class="auth-page">
        <!-- LEFT: Brand Panel -->
        <div class="auth-brand">
            <div class="brand-logo">
                <div class="brand-logo-icon">
                    <i class="fa-solid fa-vest-patches"></i>
                </div>
                <div class="brand-logo-text">EVIA <span>STUDIO</span></div>
            </div>

            <div class="brand-tagline">
                <h1>Fashion Designed<br>by You</h1>
                <p>Join EVIA's smart fashion platform — customize outfits, shop premium collections and wear your identity.</p>
            </div>

            <div class="brand-features">
                <div class="brand-feature">
                    <div class="brand-feature-icon">
                        <i class="fa-solid fa-wand-magic-sparkles"></i>
                    </div>
                    <div class="brand-feature-text">
                        <strong>Design Studio</strong>
                        <span>Generate realistic outfit previews instantly</span>
                    </div>
                </div>
                <div class="brand-feature">
                    <div class="brand-feature-icon">
                        <i class="fa-solid fa-shirt"></i>
                    </div>
                    <div class="brand-feature-text">
                        <strong>Premium Collections</strong>
                        <span>Curated fashion for every style</span>
                    </div>
                </div>
                <div class="brand-feature">
                    <div class="brand-feature-icon">
                        <i class="fa-solid fa-ruler-combined"></i>
                    </div>
                    <div class="brand-feature-text">
                        <strong>Custom Measurements</strong>
                        <span>Perfect fit, tailored just for you</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- RIGHT: Auth Form -->
        <div class="auth-form-panel">
            <div class="auth-card">
                @RenderBody()
            </div>
        </div>
    </div>

    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

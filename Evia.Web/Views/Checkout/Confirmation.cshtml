@model Order
@{
    ViewData["Title"] = "Order Confirmation #" + Model.Id;
    var payment = ViewBag.Payment as Payment;
}

<section class="section">
    <div class="panel" style="max-width:800px; margin:0 auto;">
        
        <div style="text-align:center; padding-bottom:30px; border-bottom:1px solid var(--border-color); margin-bottom:30px;">
            <div style="width:70px; height:70px; background:rgba(16,185,129,0.15); border:2px solid #10b981; border-radius:50%; display:flex; align-items:center; justify-content:center; margin:0 auto 16px;">
                <i class="fa-solid fa-check" style="font-size:32px; color:#10b981;"></i>
            </div>
            <h1 style="font-size:32px; font-weight:800; color:white;">Order Placed Successfully!</h1>
            <p style="color:var(--text-muted); font-size:16px; margin-top:8px;">Order Reference: <strong style="color:var(--accent-gold);">#EVIA-ORD-@Model.Id</strong></p>
        </div>

        <!-- Order Lifecycle Status Timeline (HCI Principle: Visibility of System Status) -->
        <div style="margin-bottom:36px; background:#0f141c; padding:24px; border-radius:var(--radius-md); border:1px solid var(--border-color);">
            <h4 style="font-size:14px; text-transform:uppercase; letter-spacing:1px; color:var(--text-muted); margin-bottom:20px; text-align:center;">
                Delivery Tracker
            </h4>
            <div style="display:flex; justify-content:space-between; position:relative; max-width:600px; margin:0 auto;">
                <div style="text-align:center; position:relative; z-index:2;">
                    <div style="width:36px; height:36px; background:#10b981; color:white; border-radius:50%; display:flex; align-items:center; justify-content:center; margin:0 auto 8px; font-weight:bold;">
                        <i class="fa-solid fa-check"></i>
                    </div>
                    <span style="font-size:12px; font-weight:600;">Placed</span>
                </div>
                <div style="text-align:center; position:relative; z-index:2;">
                    <div style="width:36px; height:36px; background:@(Model.Status == "Processing" || Model.Status == "Shipped" || Model.Status == "Delivered" ? "#10b981" : "var(--border-color)"); color:white; border-radius:50%; display:flex; align-items:center; justify-content:center; margin:0 auto 8px; font-weight:bold;">
                        <i class="fa-solid fa-scissors"></i>
                    </div>
                    <span style="font-size:12px; font-weight:600;">Processing</span>
                </div>
                <div style="text-align:center; position:relative; z-index:2;">
                    <div style="width:36px; height:36px; background:@(Model.Status == "Shipped" || Model.Status == "Delivered" ? "#10b981" : "var(--border-color)"); color:white; border-radius:50%; display:flex; align-items:center; justify-content:center; margin:0 auto 8px; font-weight:bold;">
                        <i class="fa-solid fa-truck"></i>
                    </div>
                    <span style="font-size:12px; font-weight:600;">Shipped</span>
                </div>
                <div style="text-align:center; position:relative; z-index:2;">
                    <div style="width:36px; height:36px; background:@(Model.Status == "Delivered" ? "#10b981" : "var(--border-color)"); color:white; border-radius:50%; display:flex; align-items:center; justify-content:center; margin:0 auto 8px; font-weight:bold;">
                        <i class="fa-solid fa-house-chimney"></i>
                    </div>
                    <span style="font-size:12px; font-weight:600;">Delivered</span>
                </div>
            </div>
        </div>

        <!-- Receipt Details -->
        <div style="display:grid; grid-template-columns:1fr 1fr; gap:20px; margin-bottom:30px; font-size:14px;">
            <div style="background:#0f141c; padding:16px; border-radius:var(--radius-sm);">
                <p style="color:var(--text-muted); margin-bottom:4px;">Shipping Address</p>
                <p style="font-weight:600;">@Model.ShippingAddress</p>
            </div>
            <div style="background:#0f141c; padding:16px; border-radius:var(--radius-sm);">
                <p style="color:var(--text-muted); margin-bottom:4px;">Payment Method</p>
                <p style="font-weight:600;">@Model.PaymentMethod (@Model.PaymentStatus)</p>
                @if (payment != null)
                {
                    <p style="font-size:11px; color:var(--accent-gold); margin-top:4px;">Txn: @payment.TransactionId</p>
                }
            </div>
        </div>

        <!-- Items Table -->
        <table class="cart-table" style="margin-bottom:24px;">
            <thead>
                <tr>
                    <th>Item Description</th>
                    <th>Qty</th>
                    <th>Unit Price</th>
                    <th>Total</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Items)
                {
                    <tr>
                        <td>
                            @if (item.Product != null)
                            {
                                <span>@item.Product.Name</span>
                            }
                            else if (item.CustomDesign != null)
                            {
                                <span>Custom Outfit (@item.CustomDesign.Style, @item.CustomDesign.Fabric, @item.CustomDesign.Size)</span>
                            }
                        </td>
                        <td>@item.Quantity</td>
                        <td>Rs. @item.UnitPrice.ToString("N0")</td>
                        <td style="font-weight:700; color:var(--accent-gold);">Rs. @((item.UnitPrice * item.Quantity).ToString("N0"))</td>
                    </tr>
                }
            </tbody>
        </table>

        <div style="display:flex; justify-content:space-between; align-items:center; background:#0f141c; padding:20px; border-radius:var(--radius-md); margin-bottom:30px;">
            <span style="font-size:18px; font-weight:700;">Total Paid Amount:</span>
            <span style="font-size:24px; font-weight:800; color:var(--accent-gold);">Rs. @Model.TotalAmount.ToString("N0")</span>
        </div>

        <div style="display:flex; justify-content:center; gap:16px;">
            <button onclick="window.print()" class="btn btn-secondary">
                <i class="fa-solid fa-print"></i> Print Invoice
            </button>
            <a asp-controller="Orders" asp-action="Index" class="btn">
                <i class="fa-solid fa-box-open"></i> Track All Orders
            </a>
            <a asp-controller="Shop" asp-action="Index" class="btn btn-secondary">
                Continue Shopping
            </a>
        </div>

    </div>
</section>

